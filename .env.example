# Backend (Express — local dev / Railway)
GEMINI_API_KEY=replace-with-your-gemini-api-key
AI_MODEL=gemini-2.5-flash
PORT=5001
CORS_ORIGIN=http://localhost:3000

# Frontend (Next.js — local dev / Vercel)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5001

# --- Production example (Railway + Vercel) ---
# Backend env vars (set in Railway dashboard):
#   GEMINI_API_KEY=your-key
#   AI_MODEL=gemini-2.5-flash
#   PORT=5001
#   CORS_ORIGIN=https://your-app.vercel.app
#
# Frontend env vars (set in Vercel dashboard):
#   NEXT_PUBLIC_API_BASE_URL=https://your-server.up.railway.app
